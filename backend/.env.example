# SAP Datasphere OData Service API Base URL
DATASPHERE_API_URL=https://<your-datasphere-tenant>.authentication.eu10.hana.ondemand.com/api/v1/data
# SAP Datasphere OAuth 2.0 Token Endpoint
DATASPHERE_TOKEN_URL=https://<your-datasphere-tenant>.authentication.eu10.hana.ondemand.com/oauth/token


# OAuth 2.0 Client Credentials (Provisioned in SAP BTP / Datasphere)
OAUTH_CLIENT_ID=sb-datasphere-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# Google Gemini API Key or OpenAI API Key for Query Blueprint Generation
GEMINI_API_KEY=AIzaSy...your-gemini-key
# OPENAI_API_KEY=sk-your-openai-api-key-here
